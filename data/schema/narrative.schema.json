{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "accidental-phd/narrative",
  "title": "서사 레코드",
  "description": "data/packs/narratives/<track>/records.json의 원소. 원문을 저장하지 않는다. 장면의 구조(상황·갈등·선택·결과)만 요약한다.",
  "type": "object",
  "required": ["id", "track", "stage", "theme", "summary", "quote", "source_id", "page_or_url", "year", "checked_on", "confidence"],
  "properties": {
    "id": { "type": "string", "description": "nar-<track>-<stage>-<n>. 예: nar-stem-qualifying-3", "pattern": "^nar-[a-z]+-[a-z_-]+-[0-9]+$" },
    "track": { "type": "string", "enum": ["인문사회", "이공"] },
    "stage": { "type": "string", "enum": ["admission", "coursework", "qualifying", "first-paper", "funding", "thesis", "defense", "early-career", "mid-career", "retirement"] },
    "theme": { "type": "string", "description": "자유 태그. 예: advisor-conflict, money, health, scoop, teaching" },
    "summary": { "type": "string", "description": "2~3문장. 상황·갈등·선택·결과. 저자의 문장을 쓰지 않고 구조만 적는다. 창작 각색 가능" },
    "quote": { "type": "string", "description": "15단어 이하 인용 1개 이하, 없으면 빈 문자열" },
    "source_id": { "type": "string", "description": "data/sources/registry.json의 id" },
    "page_or_url": { "type": "string" },
    "year": { "type": "integer" },
    "checked_on": { "type": "string", "format": "date" },
    "confidence": { "type": "string", "enum": ["verified", "indexed", "assumed"] },
    "decision_point": { "type": "string", "description": "선택. 이 장면을 쓸 수 있는 결정 지점 id" }
  },
  "additionalProperties": true
}
